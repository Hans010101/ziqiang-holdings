{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ziqiang-holdings",
  "account_id": "a828bebda1f352216c7d7da425bad17a",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ziqiang-holdings-db",
      "database_id": "cba3bce5-ee5a-4178-a5e3-822ae7e1d792",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "APP_NAME": "点金雷达",
    "SEC_USER_AGENT": "ZiQiangHoldings/1.0 hans.pan002@gmail.com"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
